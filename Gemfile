source "https://rubygems.org"

# Listed outright rather than through `gemspec`: bundlerEnv resolves against a
# store directory holding only a Gemfile and a lockfile, where there is no
# gemspec to read. One bundle covers the whole repository — the runtime gem,
# the release toolchain beside it, and the tooling for both.

# gem_kit-release
gem "thor", "~> 1.3"

# Tooling
gem "rake", "~> 13.0"
gem "scampi", "~> 1.0"
gem "lefthook", "~> 2.1"
